    def measure_entangled(self, qubits: List[Qubit], 
                         bases: List[int]) -> List[int]:
        """
        Measure entangled qubits in specified bases.
        
        Args:
            qubits: List of entangled qubits
            bases: Measurement bases (0, 1, 2 for 0°, 45°, 90°)
            
        Returns:
            Measurement results (0 or 1)
        """
        results = []
        
        for qubit, basis in zip(qubits, bases):
            # For entangled pairs, measurement is probabilistic
            # but correlated with the other qubit in the pair
            if basis == 0:  # 0° basis
                # Higher probability for |0> if other was |0>
                prob_0 = 0.85  # Adjust based on entanglement quality
            elif basis == 1:  # 45° basis
                prob_0 = 0.5  # Equal probability
            else:  # 90° basis
                prob_0 = 0.15  # Lower probability for |0>
            
            result = 0 if secrets.random() < prob_0 else 1
            results.append(result)
        
        return results
    
    def calculate_chsh(self, alice_results: List[int], bob_results: List[int],
                      alice_bases: List[int], bob_bases: List[int]) -> float:
        """
        Calculate CHSH inequality value for eavesdropping detection.
        
        Args:
            alice_results: Alice's measurement results
            bob_results: Bob's measurement results
            alice_bases: Alice's measurement bases
            bob_bases: Bob's measurement bases
            
        Returns:
            CHSH S-value
        """
        # Define correlation combinations
        correlations = []
        
        for a_result, b_result, a_basis, b_basis in zip(alice_results, bob_results,
                                                       alice_bases, bob_bases):
            # Calculate correlation based on basis combination
            if (a_basis, b_basis) in [(0, 1), (1, 0), (1, 2), (2, 1)]:
                # These combinations contribute to CHSH
                correlation = 1 if a_result == b_result else -1
                correlations.append(correlation)
        
        if not correlations:
            return 0.0
        
        # Calculate CHSH S-value
        s_value = abs(np.mean(correlations)) * 4  # Multiply by 4 for CHSH
        
        return s_value
    
    def estimate_error_rate(self, bits1: List[int], bits2: List[int]) -> float:
        """
        Estimate error rate between two bit strings.
        
        Args:
            bits1: First bit string
            bits2: Second bit string
            
        Returns:
            Error rate (0-1)
        """
        if len(bits1) != len(bits2):
            return 1.0
        
        errors = sum(b1 != b2 for b1, b2 in zip(bits1, bits2))
        return errors / len(bits1)

def binary_entropy(p: float) -> float:
    """
    Calculate binary entropy H(p) = -p log2(p) - (1-p) log2(1-p).
    
    Args:
        p: Probability (0-1)
        
    Returns:
        Binary entropy
    """
    if p == 0 or p == 1:
        return 0.0
    return -p * np.log2(p) - (1 - p) * np.log2(1 - p)

