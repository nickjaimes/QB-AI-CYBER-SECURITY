                                    layer_inputs[synapse.post_neuron_id] += synapse.weight
                
                # Process layer
                layer_spikes = layer.process_input(layer_inputs, dt)
                spikes_per_layer[layer_id] += len(layer_spikes)
                all_spikes.extend(layer_spikes)
                
                # Store output spikes
                if layer_id == 'output':
                    output_spikes.extend(layer_spikes)
            
            # Update synaptic weights (STDP)
            if self.learning_enabled:
                self._update_synapses(dt)
            
            # Small delay to prevent CPU hogging
            await asyncio.sleep(0.001)
        
        # Analyze output
        threat_level = self._analyze_output(output_spikes, simulation_time)
        
        # Update statistics
        processing_time = (datetime.now() - start_time).total_seconds()
        self.stats['total_spikes'] += sum(spikes_per_layer.values())
        self.stats['inference_time'] = processing_time
        
        # Update layer activity
        for layer_id, spike_count in spikes_per_layer.items():
            if layer_id not in self.stats['layer_activity']:
                self.stats['layer_activity'][layer_id] = []
            self.stats['layer_activity'][layer_id].append(spike_count)
        
        return {
            'threat_level': threat_level,
            'output_spikes': len(output_spikes),
            'spikes_per_layer': spikes_per_layer,
            'processing_time': processing_time,
            'network_activity': self._calculate_network_activity()
        }
    
    def _get_neuron_layer(self, neuron_id: int) -> Optional[str]:
        """Find which layer a neuron belongs to."""
        for layer_id, layer in self.layers.items():
            if neuron_id < layer.num_neurons:
                return layer_id
        
        return None
    
    def _update_synapses(self, dt: float):
        """Update synaptic weights using STDP."""
        for synapse in self.synapses:
            # Get pre- and post-synaptic neurons
            pre_layer = self._get_neuron_layer(synapse.pre_neuron_id)
            post_layer = self._get_neuron_layer(synapse.post_neuron_id)
            
            if not (pre_layer and post_layer):
                continue
            
            pre_neuron = self.layers[pre_layer].neurons.get(synapse.pre_neuron_id)
            post_neuron = self.layers[post_layer].neurons.get(synapse.post_neuron_id)
            
            if not (pre_neuron and post_neuron):
                continue
            
            # Update using STDP traces
            synapse.update_stdp(pre_neuron.stdp_trace, post_neuron.stdp_trace, dt)
        
        self.stats['learning_updates'] += 1
    
    def _analyze_output(self, output_spikes: List[Spike], 
                       simulation_time: float) -> float:
        """
        Analyze output spikes to determine threat level.
        
        Args:
            output_spikes: List of output layer spikes
            simulation_time: Simulation duration in ms
            
        Returns:
            Threat level (0-1)
        """
        if not output_spikes:
            return 0.0
        
        # Calculate spike rate
        spike_rate = len(output_spikes) / (simulation_time / 1000)  # Hz
        
        # Normalize to 0-1 range
        max_rate = 100.0  # Maximum expected spike rate
        threat_level = min(1.0, spike_rate / max_rate)
        
        # Consider spike timing patterns
        if len(output_spikes) > 1:
            # Calculate interspike intervals
            timestamps = sorted([s.timestamp for s in output_spikes])
            intervals = np.diff(timestamps)
            
            # Burst detection (closely spaced spikes)
            burst_threshold = 10.0  # ms
            burst_count = sum(1 for interval in intervals if interval < burst_threshold)
            
            if burst_count > 0:
                # Bursts indicate higher threat
                threat_level = min(1.0, threat_level * 1.5)
        
        return threat_level
    
    def _calculate_network_activity(self) -> Dict[str, float]:
        """Calculate current network activity levels."""
        activity = {}
        
        for layer_id, layer in self.layers.items():
            spike_rate = layer.get_spike_rate(window_ms=1000.0)
            activity[layer_id] = spike_rate
        
        return activity
    
    def train_on_threats(self, training_data: List[Tuple[Dict[str, Any], float]]):
        """
        Train SNN on labeled threat data.
        
        Args:
            training_data: List of (threat_data, label) pairs
        """
        print(f"Training SNN on {len(training_data)} examples")
        
        for threat_data, label in training_data:
            # Run simulation
            result = asyncio.run(self.process_threat(threat_data))
            
            # Calculate error
            predicted = result['threat_level']
            error = label - predicted
            
            # Adjust learning based on error
            if abs(error) > 0.2:
                # Increase learning rate for large errors
                self._adjust_learning_rate(error)
    
    def _adjust_learning_rate(self, error: float):
        """Adjust learning rate based on error."""
        for synapse in self.synapses:
            if synapse.plasticity_type == 'stdp':
                # Increase learning rate for large errors
                adjustment = 1.0 + abs(error) * 0.1
                synapse.learning_rate = min(0.1, synapse.learning_rate * adjustment)
    
