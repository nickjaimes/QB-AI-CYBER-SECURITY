"""
Adaptive Immunity System - B-Cell and T-Cell analogs
Learns from new threats and develops detection rules.
"""

import numpy as np
import hashlib
import json
from typing import Dict, List, Optional, Tuple, Any
from dataclasses import dataclass, field
from datetime import datetime, timedelta
import asyncio
from enum import Enum
import pickle
from pathlib import Path
from sklearn.cluster import DBSCAN
from sklearn.preprocessing import StandardScaler
import tensorflow as tf
from collections import defaultdict

@dataclass
class ThreatExample:
    """Training example for adaptive immunity."""
    id: str
    features: np.ndarray
    label: str
    metadata: Dict[str, Any]
    timestamp: datetime
    confidence: float

@dataclass
class DetectionRule:
    """Detection rule generated by B-Cells."""
    id: str
    name: str
    rule_type: str
    conditions: List[Dict[str, Any]]
    created_by: str  # B-Cell ID
    created_at: datetime
    confidence: float
    effectiveness: float
    usage_count: int = 0
    success_count: int = 0

class BCellType(Enum):
    """Types of B-Cells in the immune system."""
    NAIVE = "naive"          # Untrained, ready to learn
    MEMORY = "memory"        # Stores learned patterns
    PLASMA = "plasma"       # Generates detection rules
    REGULATORY = "regulatory" # Suppresses false positives

class TCellType(Enum):
    """Types of T-Cells in the immune system."""
    HELPER = "helper"        # Activates other immune cells
    CYTOTOXIC = "cytotoxic"  # Eliminates threats
    REGULATORY = "regulatory" # Modulates immune response
    MEMORY = "memory"        # Remembers specific threats

class BCell:
    """
    B-Cell analog for generating detection rules.
    """
    
    def __init__(self, cell_id: str, cell_type: BCellType, config: Dict[str, Any]):
        self.cell_id = cell_id
        self.cell_type = cell_type
        self.config = config
        self.learning_rate = config.get('learning_rate', 0.01)
        self.memory_capacity = config.get('memory_capacity', 1000)
        self.experience_memory = []  # Stores threat examples
        self.generated_rules = []    # Rules created by this cell
        self.activation_level = 0.0  # Current activation level
        self.last_activation = None
        
        # Neural network for pattern recognition
        self.model = self._build_model() if cell_type == BCellType.PLASMA else None
        
    def _build_model(self):
        """Build neural network for pattern recognition."""
        model = tf.keras.Sequential([
            tf.keras.layers.Dense(64, activation='relu', input_shape=(None, 100)),
            tf.keras.layers.Dropout(0.2),
            tf.keras.layers.Dense(32, activation='relu'),
            tf.keras.layers.Dense(16, activation='relu'),
            tf.keras.layers.Dense(1, activation='sigmoid')
        ])
        
        model.compile(
            optimizer=tf.keras.optimizers.Adam(learning_rate=self.learning_rate),
            loss='binary_crossentropy',
            metrics=['accuracy']
        )
        
        return model
    
    def activate(self, threat_data: Dict[str, Any]) -> float:
        """
        Activate B-Cell based on threat similarity.
        
        Args:
            threat_data: Threat information
            
        Returns:
            Activation level (0-1)
        """
        # Calculate similarity to stored experiences
        similarity_score = self._calculate_similarity(threat_data)
        
        # Adjust based on cell type
        if self.cell_type == BCellType.MEMORY:
            # Memory cells have higher baseline activation
            self.activation_level = min(1.0, similarity_score * 1.5)
        elif self.cell_type == BCellType.NAIVE:
            # Naive cells have lower activation threshold
            self.activation_level = similarity_score * 0.8
        else:
            self.activation_level = similarity_score
        
        self.last_activation = datetime.now()
        return self.activation_level
    
    def _calculate_similarity(self, threat_data: Dict[str, Any]) -> float:
        """Calculate similarity between threat and stored experiences."""
        if not self.experience_memory:
            return 0.0
        
        # Extract features from threat data
        threat_features = self._extract_features(threat_data)
        
        # Calculate average similarity to stored experiences
        similarities = []
        for experience in self.experience_memory[:10]:  # Check recent experiences
            exp_features = experience.features
            if len(threat_features) == len(exp_features):
                similarity = self._cosine_similarity(threat_features, exp_features)
                similarities.append(similarity)
        
        return np.mean(similarities) if similarities else 0.0
    
    def _extract_features(self, threat_data: Dict[str, Any]) -> np.ndarray:
        """Extract numerical features from threat data."""
        features = []
        
        # Network threat features
        if 'network' in threat_data:
            net_data = threat_data['network']
            features.extend([
                net_data.get('packet_size', 0),
                net_data.get('protocol', 0),
                net_data.get('source_port', 0),
                net_data.get('destination_port', 0),
                net_data.get('packet_count', 0),
            ])
        
        # File threat features
        if 'file' in threat_data:
            file_data = threat_data['file']
            features.extend([
                file_data.get('file_size', 0),
                file_data.get('entropy', 0),
                len(file_data.get('sections', [])),
            ])
        
        # Behavioral threat features
        if 'behavior' in threat_data:
            behavior_data = threat_data['behavior']
            features.extend([
                behavior_data.get('event_count', 0),
                behavior_data.get('unique_processes', 0),
                behavior_data.get('failed_attempts', 0),
            ])
        
        # Pad or truncate to fixed length
        target_length = 100
        if len(features) < target_length:
            features.extend([0] * (target_length - len(features)))
        else:
            features = features[:target_length]
        
        return np.array(features, dtype=np.float32)
    
    def _cosine_similarity(self, vec1: np.ndarray, vec2: np.ndarray) -> float:
        """Calculate cosine similarity between two vectors."""
        dot_product = np.dot(vec1, vec2)
        norm1 = np.linalg.norm(vec1)
        norm2 = np.linalg.norm(vec2)
        
        if norm1 == 0 or norm2 == 0:
            return 0.0
        
        return dot_product / (norm1 * norm2)
    
    def learn_from_experience(self, threat_example: ThreatExample):
        """
        Learn from a new threat example.
        
        Args:
            threat_example: Threat example to learn from
        """
        # Add to experience memory
        self.experience_memory.append(threat_example)
        
        # Maintain memory capacity
        if len(self.experience_memory) > self.memory_capacity:
            # Remove oldest experiences
            self.experience_memory = self.experience_memory[-self.memory_capacity:]
        
        # Update neural network if this is a plasma cell
        if self.cell_type == BCellType.PLASMA and self.model is not None:
            self._update_model(threat_example)
        
        # Generate detection rule if activation was high
        if self.activation_level > 0.8 and self.cell_type == BCellType.PLASMA:
            rule = self._generate_detection_rule(threat_example)
            if rule:
                self.generated_rules.append(rule)
    
    def _update_model(self, threat_example: ThreatExample):
        """Update neural network with new example."""
        # Prepare training data
        X = threat_example.features.reshape(1, -1)
        y = np.array([1.0 if threat_example.label == 'malicious' else 0.0])
        
        # Train for one epoch
        self.model.fit(X, y, epochs=1, verbose=0)
    
    def _generate_detection_rule(self, threat_example: ThreatExample) -> Optional[DetectionRule]:
        """Generate detection rule from threat example."""
        # Extract rule conditions from features
        features = threat_example.features
        conditions = []
        
        # Create conditions based on significant features
        significant_indices = np.where(features > np.percentile(features, 75))[0]
        
        for idx in significant_indices[:5]:  # Limit to 5 conditions
            condition = {
                'feature_index': int(idx),
                'threshold': float(features[idx]),
                'comparison': 'greater_than'
            }
            conditions.append(condition)
        
        if not conditions:
            return None
        
        rule_id = f"rule_{hashlib.md5(str(conditions).encode()).hexdigest()[:8]}"
        
        return DetectionRule(
            id=rule_id,
            name=f"AutoRule_{threat_example.label}",
            rule_type="feature_threshold",
            conditions=conditions,
            created_by=self.cell_id,
            created_at=datetime.now(),
            confidence=threat_example.confidence,
            effectiveness=0.5  # Initial effectiveness
        )
    
    def evaluate_rule(self, rule: DetectionRule, test_data: List[ThreatExample]) -> float:
        """Evaluate rule effectiveness on test data."""
        if not test_data:
            return 0.0
        
        correct_predictions = 0
        total_predictions = 0
        
        for example in test_data:
            prediction = self._apply_rule(rule, example.features)
            actual = 1 if example.label == 'malicious' else 0
            
            if prediction == actual:
                correct_predictions += 1
            total_predictions += 1
        
        effectiveness = correct_predictions / total_predictions if total_predictions > 0 else 0.0
        
        # Update rule statistics
        rule.effectiveness = effectiveness
        rule.usage_count += total_predictions
        rule.success_count += correct_predictions
        
        return effectiveness
    
    def _apply_rule(self, rule: DetectionRule, features: np.ndarray) -> int:
        """Apply rule to features to make prediction."""
        for condition in rule.conditions:
            feature_idx = condition['feature_index']
            threshold = condition['threshold']
            comparison = condition['comparison']
            
            if feature_idx >= len(features):
                continue
            
            feature_value = features[feature_idx]
            
            if comparison == 'greater_than':
                if feature_value <= threshold:
                    return 0  # Not malicious
            elif comparison == 'less_than':
                if feature_value >= threshold:
                    return 0  # Not malicious
            elif comparison == 'equals':
                if feature_value != threshold:
                    return 0  # Not malicious
        
        # All conditions met
        return 1  # Malicious
    
    def get_status(self) -> Dict[str, Any]:
        """Get B-Cell status."""
        return {
            'cell_id': self.cell_id,
            'cell_type': self.cell_type.value,
            'activation_level': self.activation_level,
            'experience_count': len(self.experience_memory),
            'rule_count': len(self.generated_rules),
            'last_activation': self.last_activation.isoformat() if self.last_activation else None
        }

class TCell:
    """
    T-Cell analog for coordinating immune response.
    """
    
    def __init__(self, cell_id: str, cell_type: TCellType, config: Dict[str, Any]):
        self.cell_id = cell_id
        self.cell_type = cell_type
        self.config = config
        self.response_strategies = {}
        self.coordination_history = []
        self.activated_bcells = []  # B-Cells activated by this T-Cell
        
        # Response effectiveness tracking
        self.response_effectiveness = {
            'total_responses': 0,
            'successful_responses': 0,
            'average_response_time': 0.0
        }
    
    def coordinate_response(self, threat_data: Dict[str, Any], bcell_activations: Dict[str, float]) -> Dict[str, Any]:
        """
        Coordinate response to threat based on B-Cell activations.
        
        Args:
            threat_data: Threat information
            bcell_activations: Dictionary of B-Cell ID -> activation level
            
        Returns:
            Response plan
        """
        # Determine threat severity
        threat_severity = self._assess_threat_severity(threat_data, bcell_activations)
        
        # Select response strategy based on cell type
        if self.cell_type == TCellType.HELPER:
            response = self._helper_response(threat_severity, bcell_activations)
        elif self.cell_type == TCellType.CYTOTOXIC:
            response = self._cytotoxic_response(threat_severity, threat_data)
        elif self.cell_type == TCellType.REGULATORY:
            response = self._regulatory_response(threat_severity, bcell_activations)
        else:
            response = self._default_response(threat_severity)
        
        # Activate appropriate B-Cells
        activated_cells = self._activate_bcells(bcell_activations, threat_severity)
        self.activated_bcells.extend(activated_cells)
        
        # Record coordination
        self.coordination_history.append({
            'timestamp': datetime.now(),
            'threat_severity': threat_severity,
            'response_type': response['action'],
            'activated_cells': activated_cells
        })
        
        # Update statistics
        self.response_effectiveness['total_responses'] += 1
        
        return response
    
    def _assess_threat_severity(self, threat_data: Dict[str, Any], bcell_activations: Dict[str, float]) -> str:
        """Assess threat severity based on B-Cell activations."""
        # Calculate average activation
        activations = list(bcell_activations.values())
        if not activations:
            return 'low'
        
        avg_activation = np.mean(activations)
        max_activation = np.max(activations)
        
        # Determine severity
        if max_activation > 0.9 or avg_activation > 0.7:
            return 'critical'
        elif max_activation > 0.7 or avg_activation > 0.5:
            return 'high'
        elif max_activation > 0.5 or avg_activation > 0.3:
            return 'medium'
        else:
            return 'low'
    
    def _helper_response(self, severity: str, bcell_activations: Dict[str, float]) -> Dict[str, Any]:
        """Helper T-Cell response - amplifies immune response."""
        # Identify most activated B-Cells
        sorted_activations = sorted(bcell_activations.items(), key=lambda x: x[1], reverse=True)
        top_bcells = [cell_id for cell_id, activation in sorted_activations[:3]]
        
        return {
            'action': 'amplify_response',
            'severity': severity,
            'amplification_factor': 2.0 if severity in ['high', 'critical'] else 1.5,
            'target_cells': top_bcells,
            'response_time': 'immediate'
        }
    
    def _cytotoxic_response(self, severity: str, threat_data: Dict[str, Any]) -> Dict[str, Any]:
        """Cytotoxic T-Cell response - eliminates threats."""
        response_actions = []
        
        if 'network' in threat_data:
            response_actions.append({
                'type': 'network_block',
                'target': threat_data['network'].get('source_ip'),
                'duration': 'permanent' if severity in ['high', 'critical'] else 'temporary'
            })
        
        if 'process' in threat_data:
            response_actions.append({
                'type': 'process_termination',
                'pid': threat_data['process'].get('pid'),
                'force': True
            })
        
        if 'file' in threat_data:
            response_actions.append({
                'type': 'file_quarantine',
                'path': threat_data['file'].get('path')
            })
        
        return {
            'action': 'eliminate_threat',
            'severity': severity,
            'actions': response_actions,
            'response_time': 'immediate'
        }
    
    def _regulatory_response(self, severity: str, bcell_activations: Dict[str, float]) -> Dict[str, Any]:
        """Regulatory T-Cell response - modulates immune response."""
        # Calculate activation spread
        activations = list(bcell_activations.values())
        activation_std = np.std(activations) if len(activations) > 1 else 0.0
        
        # Determine modulation
        if activation_std > 0.3:
            # High variance, need to normalize response
            modulation = 'normalize'
            modulation_strength = 0.7
        else:
            # Stable activation, fine-tune response
            modulation = 'fine_tune'
            modulation_strength = 0.3
        
        return {
            'action': 'modulate_response',
            'severity': severity,
            'modulation_type': modulation,
            'modulation_strength': modulation_strength,
            'target_variance': 0.2,  # Target activation variance
            'response_time': 'gradual'
        }
    
    def _default_response(self, severity: str) -> Dict[str, Any]:
        """Default response strategy."""
        return {
            'action': 'monitor',
            'severity': severity,
            'monitoring_intensity': 'high' if severity in ['high', 'critical'] else 'medium',
            'response_time': 'delayed'
        }
    
    def _activate_bcells(self, bcell_activations: Dict[str, float], severity: str) -> List[str]:
        """Activate B-Cells based on activation levels."""
        activation_threshold = {
            'critical': 0.5,
            'high': 0.6,
            'medium': 0.7,
            'low': 0.8
        }
        
        threshold = activation_threshold.get(severity, 0.7)
        activated = [cell_id for cell_id, activation in bcell_activations.items() 
                    if activation >= threshold]
        
        return activated
    
    def learn_response_effectiveness(self, response_result: Dict[str, Any]):
        """Learn from response effectiveness."""
        success = response_result.get('success', False)
        response_time = response_result.get('response_time', 0.0)
        
        if success:
            self.response_effectiveness['successful_responses'] += 1
        
        # Update average response time
        total = self.response_effectiveness['total_responses']
        current_avg = self.response_effectiveness['average_response_time']
        new_avg = (current_avg * (total - 1) + response_time) / total if total > 0 else response_time
        self.response_effectiveness['average_response_time'] = new_avg
        
        # Store response strategy for future reference
        strategy_key = response_result.get('strategy_hash')
        if strategy_key:
            if strategy_key not in self.response_strategies:
                self.response_strategies[strategy_key] = {
                    'usage_count': 0,
                    'success_count': 0,
                    'average_time': 0.0
                }
            
            strategy = self.response_strategies[strategy_key]
            strategy['usage_count'] += 1
            if success:
                strategy['success_count'] += 1
            strategy['average_time'] = (
                (strategy['average_time'] * (strategy['usage_count'] - 1) + response_time) /
                strategy['usage_count']
            )
    
    def get_optimal_response(self, threat_type: str) -> Optional[Dict[str, Any]]:
        """Get optimal response strategy for threat type."""
        # Find most successful strategy for this threat type
        strategies = []
        for strategy_key, stats in self.response_strategies.items():
            if threat_type in strategy_key:
                success_rate = stats['success_count'] / stats['usage_count'] if stats['usage_count'] > 0 else 0
                strategies.append((success_rate, strategy_key, stats))
        
        if not strategies:
            return None
        
        # Return strategy with highest success rate
        strategies.sort(reverse=True, key=lambda x: x[0])
        best_success_rate, best_key, best_stats = strategies[0]
        
        return {
            'strategy_key': best_key,
            'success_rate': best_success_rate,
            'usage_count': best_stats['usage_count'],
            'average_response_time': best_stats['average_time']
        }
    
    def get_status(self) -> Dict[str, Any]:
        """Get T-Cell status."""
        return {
            'cell_id': self.cell_id,
            'cell_type': self.cell_type.value,
            'response_effectiveness': self.response_effectiveness,
            'coordination_count': len(self.coordination_history),
            'active_bcells': len(self.activated_bcells),
            'learned_strategies': len(self.response_strategies)
        }

class AdaptiveImmuneSystem:
    """
    Main adaptive immune system orchestrator.
    Manages B-Cells and T-Cells for adaptive threat response.
    """
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.bcells: Dict[str, BCell] = {}
        self.tcells: Dict[str, TCell] = {}
        self.detection_rules: Dict[str, DetectionRule] = {}
        self.threat_history = []
        
        # Initialize immune cells
        self._initialize_immune_cells()
        
        # Clustering for threat pattern discovery
        self.scaler = StandardScaler()
        self.clusterer = DBSCAN(eps=0.5, min_samples=2)
        
        # Training data
        self.training_examples = []
        
    def _initialize_immune_cells(self):
        """Initialize B-Cells and T-Cells."""
        # Create B-Cells
        bcell_config = self.config.get('bcell_config', {})
        bcell_types = [
            (BCellType.NAIVE, 10),      # 10 naive cells
            (BCellType.MEMORY, 5),      # 5 memory cells
            (BCellType.PLASMA, 8),      # 8 plasma cells
            (BCellType.REGULATORY, 3)   # 3 regulatory cells
        ]
        
        for cell_type, count in bcell_types:
            for i in range(count):
                cell_id = f"bcell_{cell_type.value}_{i}"
                self.bcells[cell_id] = BCell(cell_id, cell_type, bcell_config)
        
        # Create T-Cells
        tcell_config = self.config.get('tcell_config', {})
        tcell_types = [
            (TCellType.HELPER, 4),      # 4 helper cells
            (TCellType.CYTOTOXIC, 6),   # 6 cytotoxic cells
            (TCellType.REGULATORY, 3),  # 3 regulatory cells
            (TCellType.MEMORY, 2)       # 2 memory cells
        ]
        
        for cell_type, count in tcell_types:
            for i in range(count):
                cell_id = f"tcell_{cell_type.value}_{i}"
                self.tcells[cell_id] = TCell(cell_id, cell_type, tcell_config)
        
        print(f"Initialized {len(self.bcells)} B-Cells and {len(self.tcells)} T-Cells")
    
    async def process_threat(self, threat_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Process threat through adaptive immune system.
        
        Args:
            threat_data: Threat information
            
        Returns:
            Adaptive response
        """
        start_time = datetime.now()
        
        # Step 1: Activate B-Cells
        bcell_activations = {}
        for bcell_id, bcell in self.bcells.items():
            activation = bcell.activate(threat_data)
            bcell_activations[bcell_id] = activation
        
        # Step 2: Coordinate response with T-Cells
        responses = []
        for tcell_id, tcell in self.tcells.items():
            response = tcell.coordinate_response(threat_data, bcell_activations)
            responses.append({
                'tcell_id': tcell_id,
                'response': response
            })
        
        # Step 3: Consolidate responses
        consolidated_response = self._consolidate_responses(responses)
        
        # Step 4: Generate detection rules from highly activated plasma cells
        detection_rules = []
        for bcell_id, activation in bcell_activations.items():
            bcell = self.bcells[bcell_id]
            if bcell.cell_type == BCellType.PLASMA and activation > 0.8:
                # Create threat example for learning
                threat_example = ThreatExample(
                    id=hashlib.md5(str(threat_data).encode()).hexdigest(),
                    features=bcell._extract_features(threat_data),
                    label='malicious' if consolidated_response['severity'] in ['high', 'critical'] else 'benign',
                    metadata=threat_data,
                    timestamp=datetime.now(),
                    confidence=activation
                )
                
                # Learn from experience
                bcell.learn_from_experience(threat_example)
                
                # Store for clustering
                self.training_examples.append(threat_example)
                
                # Collect new rules
                detection_rules.extend(bcell.generated_rules)
        
        # Step 5: Update detection rules database
        for rule in detection_rules:
            if rule.id not in self.detection_rules:
                self.detection_rules[rule.id] = rule
        
        # Step 6: Perform clustering to discover new threat patterns
        if len(self.training_examples) >= 10:
            self._discover_threat_patterns()
        
        # Record threat in history
        processing_time = (datetime.now() - start_time).total_seconds()
        self.threat_history.append({
            'timestamp': datetime.now(),
            'threat_data': threat_data,
            'bcell_activations': bcell_activations,
            'response': consolidated_response,
            'processing_time': processing_time,
            'new_rules_generated': len(detection_rules)
        })
        
        # Trim history
        if len(self.threat_history) > 1000:
            self.threat_history = self.threat_history[-1000:]
        
        return {
            'adaptive_response': consolidated_response,
            'bcell_activations': bcell_activations,
            'detection_rules_generated': len(detection_rules),
            'processing_time': processing_time,
            'timestamp': datetime.now().isoformat()
        }
    
    def _consolidate_responses(self, responses: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Consolidate multiple T-Cell responses."""
        if not responses:
            return {'action': 'monitor', 'severity': 'low'}
        
        # Group by response type
        response_counts = defaultdict(int)
        severity_counts = defaultdict(int)
        all_actions = []
        
        for response in responses:
            resp_data = response['response']
            response_counts[resp_data['action']] += 1
            severity_counts[resp_data['severity']] += 1
            all_actions.append(resp_data)
        
        # Determine most common response
        most_common_response = max(response_counts.items(), key=lambda x: x[1])
        most_common_severity = max(severity_counts.items(), key=lambda x: x[1])
        
        # Find cytotoxic responses for elimination actions
        cytotoxic_actions = []
        for response in responses:
            if 'cytotoxic' in response['tcell_id']:
                cytotoxic_actions.append(response['response'])
        
        # Build consolidated response
        consolidated = {
            'action': most_common_response[0],
            'severity': most_common_severity[0],
            'confidence': most_common_response[1] / len(responses),
            'supporting_cells': len(responses),
            'cytotoxic_actions': cytotoxic_actions
        }
        
        return consolidated
    
    def _discover_threat_patterns(self):
        """Discover new threat patterns through clustering."""
        if len(self.training_examples) < 10:
            return
        
        # Prepare features for clustering
        features = np.array([ex.features for ex in self.training_examples[-100:]])  # Use recent examples
        
        # Scale features
        features_scaled = self.scaler.fit_transform(features)
        
        # Perform clustering
        clusters = self.clusterer.fit_predict(features_scaled)
        
        # Analyze clusters for patterns
        unique_clusters = np.unique(clusters)
        patterns = []
        
        for cluster_id in unique_clusters:
            if cluster_id == -1:  # Noise
                continue
            
            # Get examples in this cluster
            cluster_indices = np.where(clusters == cluster_id)[0]
            cluster_examples = [self.training_examples[i] for i in cluster_indices]
            
            # Analyze common features
            if len(cluster_examples) >= 3:  # Minimum cluster size
                pattern = self._analyze_cluster_pattern(cluster_examples)
                if pattern:
                    patterns.append(pattern)
        
        # Generate rules from discovered patterns
        for pattern in patterns:
            rule = self._create_pattern_rule(pattern)
            if rule and rule.id not in self.detection_rules:
                self.detection_rules[rule.id] = rule
    
    def _analyze_cluster_pattern(self, examples: List[ThreatExample]) -> Optional[Dict[str, Any]]:
        """Analyze cluster to discover threat pattern."""
        if not examples:
            return None
        
        # Calculate feature statistics
        features_matrix = np.array([ex.features for ex in examples])
        mean_features = np.mean(features_matrix, axis=0)
        std_features = np.std(features_matrix, axis=0)
        
        # Find significant features (high mean, low variance)
        significant_indices = np.where((mean_features > 0.5) & (std_features < 0.2))[0]
        
        if len(significant_indices) == 0:
            return None
        
        # Get common labels
        labels = [ex.label for ex in examples]
        most_common_label = max(set(labels), key=labels.count)
        
        return {
            'feature_indices': significant_indices.tolist(),
            'feature_means': mean_features[significant_indices].tolist(),
            'label': most_common_label,
            'cluster_size': len(examples),
            'confidence': len([l for l in labels if l == most_common_label]) / len(labels)
        }
    
    def _create_pattern_rule(self, pattern: Dict[str, Any]) -> Optional[DetectionRule]:
        """Create detection rule from discovered pattern."""
        conditions = []
        
        for i, feature_idx in enumerate(pattern['feature_indices'][:5]):  # Limit to 5 conditions
            mean_value = pattern['feature_means'][i]
            conditions.append({
                'feature_index': int(feature_idx),
                'threshold': float(mean_value * 0.9),  # 90% of mean
                'comparison': 'greater_than'
            })
        
        if not conditions:
            return None
        
        rule_id = f"pattern_rule_{hashlib.md5(str(pattern).encode()).hexdigest()[:8]}"
        
        return DetectionRule(
            id=rule_id,
            name=f"PatternRule_{pattern['label']}",
            rule_type="cluster_pattern",
            conditions=conditions,
            created_by="clustering_engine",
            created_at=datetime.now(),
            confidence=pattern['confidence'],
            effectiveness=0.6  # Initial effectiveness
        )
    
    def apply_detection_rules(self, features: np.ndarray) -> List[Dict[str, Any]]:
        """
        Apply all detection rules to features.
        
        Args:
            features: Feature vector
            
        Returns:
            List of matching rules
        """
        matches = []
        
        for rule_id, rule in self.detection_rules.items():
            # Skip low-confidence rules
            if rule.confidence < 0.5:
                continue
            
            # Apply rule
            is_match = True
            for condition in rule.conditions:
                feature_idx = condition['feature_index']
                threshold = condition['threshold']
                comparison = condition['comparison']
                
                if feature_idx >= len(features):
                    is_match = False
                    break
                
                feature_value = features[feature_idx]
                
                if comparison == 'greater_than' and feature_value <= threshold:
                    is_match = False
                    break
                elif comparison == 'less_than' and feature_value >= threshold:
                    is_match = False
                    break
                elif comparison == 'equals' and feature_value != threshold:
                    is_match = False
                    break
            
            if is_match:
                matches.append({
                    'rule_id': rule_id,
                    'rule_name': rule.name,
                    'confidence': rule.confidence,
                    'effectiveness': rule.effectiveness,
                    'usage_count': rule.usage_count
                })
        
        return matches
    
    def evaluate_rule_performance(self, test_data: List[Tuple[np.ndarray, str]]):
        """Evaluate performance of all detection rules."""
        for rule_id, rule in self.detection_rules.items():
            # Skip newly created rules
            if rule.usage_count < 10:
                continue
            
            correct = 0
            total = 0
            
            for features, label in test_data:
                # Apply rule
                is_match = True
                for condition in rule.conditions:
                    feature_idx = condition['feature_index']
                    threshold = condition['threshold']
                    comparison = condition['comparison']
                    
                    if feature_idx >= len(features):
                        is_match = False
                        break
                    
                    feature_value = features[feature_idx]
                    
                    if comparison == 'greater_than' and feature_value <= threshold:
                        is_match = False
                        break
                    elif comparison == 'less_than' and feature_value >= threshold:
                        is_match = False
                        break
                    elif comparison == 'equals' and feature_value != threshold:
                        is_match = False
                        break
                
                # Check if prediction matches label
                predicted_malicious = is_match
                actual_malicious = label == 'malicious'
                
                if predicted_malicious == actual_malicious:
                    correct += 1
                total += 1
            
            if total > 0:
                # Update rule effectiveness
                old_effectiveness = rule.effectiveness
                new_effectiveness = correct / total
                
                # Moving average update
                rule.effectiveness = 0.8 * old_effectiveness + 0.2 * new_effectiveness
                
                # Update confidence based on effectiveness
                rule.confidence = min(1.0, rule.confidence * (1 + (new_effectiveness - 0.5)))
    
    def get_system_status(self) -> Dict[str, Any]:
        """Get adaptive immune system status."""
        # Calculate statistics
        bcell_stats = defaultdict(int)
