@dataclass
class Spike:
    """Represents a neural spike event."""
    neuron_id: int
    timestamp: float  # in milliseconds
    amplitude: float
    source: str
    metadata: Dict[str, Any] = field(default_factory=dict)

@dataclass
class Neuron:
    """Leaky Integrate-and-Fire (LIF) neuron model."""
    neuron_id: int
    layer: str
    membrane_potential: float = -65.0  # mV
    threshold: float = -50.0  # mV
    reset_potential: float = -65.0  # mV
    tau_mem: float = 20.0  # ms (membrane time constant)
    last_spike_time: float = -1.0
    refractory_period: float = 2.0  # ms
    adaptation: float = 0.0
    learning_rate: float = 0.01
    
    # STDP parameters
    stdp_trace: float = 0.0
    tau_stdp: float = 20.0
    
    def update(self, current_input: float, dt: float = 1.0) -> Optional[Spike]:
        """
        Update neuron state and check for spike.
        
        Args:
            current_input: Input current
            dt: Time step in ms
            
        Returns:
            Spike if fired, None otherwise
        """
        # Check refractory period
        time_since_last_spike = self.last_spike_time if self.last_spike_time > 0 else 1000
        if time_since_last_spike < self.refractory_period:
            return None
        
        # Update membrane potential (LIF equation)
        dv = (-self.membrane_potential + self.reset_potential + current_input) / self.tau_mem
        self.membrane_potential += dv * dt
        
        # Add adaptation
        self.membrane_potential -= self.adaptation
        
        # Check for spike
        if self.membrane_potential >= self.threshold:
            # Generate spike
            spike = Spike(
                neuron_id=self.neuron_id,
                timestamp=datetime.now().timestamp() * 1000,  # Convert to ms
                amplitude=1.0,
                source=f"neuron_{self.neuron_id}",
                metadata={
                    'membrane_potential': self.membrane_potential,
                    'layer': self.layer
                }
            )
            
            # Reset membrane potential
            self.membrane_potential = self.reset_potential
            self.last_spike_time = spike.timestamp
            
            # Update STDP trace
            self.stdp_trace = 1.0
            
            return spike
        
        # Decay STDP trace
        self.stdp_trace *= np.exp(-dt / self.tau_stdp)
        
        return None

@dataclass
class Synapse:
    """Synaptic connection between neurons."""
    pre_neuron_id: int
    post_neuron_id: int
    weight: float
    delay: float  # ms
    plasticity_type: str  # 'stdp', 'hebbian', 'static'
    learning_rate: float = 0.001
    
    # STDP parameters
    A_plus: float = 0.01  # Potentiation rate
    A_minus: float = 0.012  # Depression rate
    tau_plus: float = 20.0  # Potentiation time constant
    tau_minus: float = 20.0  # Depression time constant
    
    def update_stdp(self, pre_trace: float, post_trace: float, dt: float = 1.0):
        """
        Update weight using Spike-Timing-Dependent Plasticity.
        
        Args:
            pre_trace: Pre-synaptic trace
            post_trace: Post-synaptic trace
            dt: Time step
        """
        if self.plasticity_type != 'stdp':
            return
        
        # STDP rule: Δw = A_plus * exp(-Δt/τ_plus) for Δt > 0 (LTP)
        #              A_minus * exp(Δt/τ_minus) for Δt < 0 (LTD)
        
        # Using traces approximation
        delta_w = self.A_plus * pre_trace - self.A_minus * post_trace
        self.weight += delta_w * self.learning_rate * dt
        
        # Clamp weight
        self.weight = max(-1.0, min(1.0, self.weight))

class SNNLayer:
    """Layer of spiking neurons."""
    
    def __init__(self, layer_id: str, num_neurons: int, neuron_type: str = "lif"):
        self.layer_id = layer_id
        self.num_neurons = num_neurons
        self.neuron_type = neuron_type
        self.neurons: Dict[int, Neuron] = {}
        self.spike_history = deque(maxlen=10000)
        
        # Initialize neurons
        for i in range(num_neurons):
            self.neurons[i] = Neuron(
                neuron_id=i,
                layer=layer_id,
                threshold=-50.0 + np.random.randn() * 5.0,  # Add some variance
                tau_mem=20.0 + np.random.randn() * 2.0
            )
    
    def process_input(self, input_currents: np.ndarray, dt: float = 1.0) -> List[Spike]:
        """
        Process input currents through layer.
        
        Args:
            input_currents: Array of input currents (one per neuron)
            dt: Time step in ms
            
        Returns:
            List of generated spikes
        """
        spikes = []
        
        for i, neuron in self.neurons.items():
            if i < len(input_currents):
                current = input_currents[i]
                spike = neuron.update(current, dt)
                if spike:
                    spikes.append(spike)
                    self.spike_history.append(spike)
        
        return spikes
    
    def get_spike_rate(self, window_ms: float = 1000.0) -> float:
        """
        Calculate average spike rate in window.
        
        Args:
            window_ms: Time window in ms
            
        Returns:
            Average spike rate in Hz
        """
        if not self.spike_history:
            return 0.0
        
        current_time = datetime.now().timestamp() * 1000
        recent_spikes = [s for s in self.spike_history 
                        if current_time - s.timestamp <= window_ms]
        
        if not recent_spikes:
            return 0.0
        
        time_span = window_ms / 1000.0  # Convert to seconds
        return len(recent_spikes) / (self.num_neurons * time_span)
    
    def get_activity_pattern(self, window_ms: float = 100.0) -> np.ndarray:
        """
        Get recent activity pattern.
        
        Args:
            window_ms: Time window in ms
            
        Returns:
            Binary array indicating which neurons fired
        """
        pattern = np.zeros(self.num_neurons, dtype=bool)
        current_time = datetime.now().timestamp() * 1000
        
        for spike in self.spike_history:
            if current_time - spike.timestamp <= window_ms:
                pattern[spike.neuron_id] = True
        
        return pattern

