"""
Pattern Recognition Receptors (PRRs) - Innate Immunity System
Detects known threats using signatures, patterns, and behavioral analysis.
"""

import re
import hashlib
import json
from typing import Dict, List, Optional, Tuple, Any
from dataclasses import dataclass, field
from enum import Enum
import numpy as np
from datetime import datetime, timedelta
import asyncio
from concurrent.futures import ThreadPoolExecutor
import pickle
from pathlib import Path

@dataclass
class ThreatSignature:
    """Represents a known threat signature."""
    id: str
    name: str
    signature_type: str  # regex, hash, behavioral, quantum_pattern
    pattern: Any
    metadata: Dict[str, Any]
    created_at: datetime
    updated_at: datetime
    confidence: float
    severity: str  # critical, high, medium, low
    
class SignatureType(Enum):
    REGEX = "regex"
    HASH = "hash"
    BEHAVIORAL = "behavioral"
    QUANTUM_PATTERN = "quantum_pattern"
    NETWORK_FLOW = "network_flow"
    FILE_SIGNATURE = "file_signature"

class PatternRecognitionReceptor:
    """
    Innate Immunity - Pattern Recognition Receptors
    First line of defense against known threats.
    """
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.signatures: Dict[str, ThreatSignature] = {}
        self.signature_cache = {}
        self.compiled_patterns = {}
        self.performance_stats = {
            'scans_completed': 0,
            'threats_detected': 0,
            'false_positives': 0,
            'average_scan_time': 0.0
        }
        
        # Thread pool for parallel scanning
        self.thread_pool = ThreadPoolExecutor(
            max_workers=config.get('max_workers', 8)
        )
        
        # Load signatures
        self._load_signatures()
        
    def _load_signatures(self):
        """Load threat signatures from database or files."""
        signature_paths = [
            Path("data/signatures/known_malware.json"),
            Path("data/signatures/network_attacks.json"),
            Path("data/signatures/behavioral_patterns.json")
        ]
        
        for path in signature_paths:
            if path.exists():
                with open(path, 'r') as f:
                    signatures_data = json.load(f)
                    for sig_data in signatures_data:
                        signature = ThreatSignature(
                            id=sig_data['id'],
                            name=sig_data['name'],
                            signature_type=sig_data['type'],
                            pattern=sig_data['pattern'],
                            metadata=sig_data.get('metadata', {}),
                            created_at=datetime.fromisoformat(sig_data['created_at']),
                            updated_at=datetime.fromisoformat(sig_data['updated_at']),
                            confidence=sig_data['confidence'],
                            severity=sig_data['severity']
                        )
                        self.signatures[signature.id] = signature
                        
                        # Pre-compile regex patterns
                        if signature.signature_type == SignatureType.REGEX.value:
                            try:
                                self.compiled_patterns[signature.id] = re.compile(
                                    signature.pattern, 
                                    re.IGNORECASE | re.DOTALL
                                )
                            except re.error:
                                print(f"Invalid regex pattern for signature {signature.id}")
        
        print(f"Loaded {len(self.signatures)} threat signatures")
    
    async def scan_network_packet(self, packet_data: bytes) -> List[Dict[str, Any]]:
        """
        Scan network packet for known threats.
        
        Args:
            packet_data: Raw packet bytes
            
        Returns:
            List of detected threats with metadata
        """
        threats = []
        
        # Convert packet to string for pattern matching
        packet_str = packet_data.decode('utf-8', errors='ignore')
        
        # Check against regex signatures
        for sig_id, signature in self.signatures.items():
            if signature.signature_type == SignatureType.REGEX.value:
                compiled = self.compiled_patterns.get(sig_id)
                if compiled and compiled.search(packet_str):
                    threats.append({
                        'signature_id': sig_id,
                        'signature_name': signature.name,
                        'confidence': signature.confidence,
                        'severity': signature.severity,
                        'matched_pattern': compiled.pattern[:100] + '...',
                        'detection_type': 'regex_match'
                    })
            
            elif signature.signature_type == SignatureType.HASH.value:
                # Calculate hash of packet
                packet_hash = hashlib.sha256(packet_data).hexdigest()
                if packet_hash == signature.pattern:
                    threats.append({
                        'signature_id': sig_id,
                        'signature_name': signature.name,
                        'confidence': signature.confidence,
                        'severity': signature.severity,
                        'matched_pattern': packet_hash,
                        'detection_type': 'hash_match'
                    })
        
        # Update statistics
        self.performance_stats['scans_completed'] += 1
        self.performance_stats['threats_detected'] += len(threats)
        
        return threats
    
    async def scan_file(self, file_path: str, file_data: Optional[bytes] = None) -> List[Dict[str, Any]]:
        """
        Scan file for known malware signatures.
        
        Args:
            file_path: Path to file
            file_data: Optional file bytes (if already loaded)
            
        Returns:
            List of detected threats
        """
        threats = []
        
        try:
            # Read file if data not provided
            if file_data is None:
                with open(file_path, 'rb') as f:
                    file_data = f.read()
            
            # Check file signatures
            file_hash = hashlib.sha256(file_data).hexdigest()
            
            for sig_id, signature in self.signatures.items():
                if signature.signature_type == SignatureType.HASH.value:
                    if file_hash == signature.pattern:
                        threats.append({
                            'signature_id': sig_id,
                            'signature_name': signature.name,
                            'file_path': file_path,
                            'confidence': signature.confidence,
                            'severity': signature.severity,
                            'detection_type': 'file_hash_match'
                        })
                
                elif signature.signature_type == SignatureType.REGEX.value:
                    # Search for patterns in file content
                    file_str = file_data.decode('utf-8', errors='ignore')
                    compiled = self.compiled_patterns.get(sig_id)
                    if compiled and compiled.search(file_str):
                        threats.append({
                            'signature_id': sig_id,
                            'signature_name': signature.name,
                            'file_path': file_path,
                            'confidence': signature.confidence,
                            'severity': signature.severity,
                            'detection_type': 'file_content_match'
                        })
            
            # Check for PE file signatures (Windows executables)
            if len(file_data) > 64 and file_data[:2] == b'MZ':
                # This is a PE file, check for specific malware patterns
                pe_threats = await self._scan_pe_file(file_data)
                threats.extend(pe_threats)
        
        except Exception as e:
            print(f"Error scanning file {file_path}: {e}")
        
        return threats
    
    async def _scan_pe_file(self, file_data: bytes) -> List[Dict[str, Any]]:
        """Scan PE file for specific malware patterns."""
        threats = []
        
        # Check for common malware sections
        suspicious_sections = ['.text', '.data', '.rsrc', '.reloc']
        
        # Look for packer signatures
        packer_signatures = {
            'UPX': b'UPX',
            'ASPack': b'ASPack',
            'PECompact': b'PEC2',
            'FSG': b'FSG',
            'Petite': b'Petite'
        }
        
        for packer_name, signature in packer_signatures.items():
            if signature in file_data:
                threats.append({
                    'signature_name': f'Packer_{packer_name}',
                    'confidence': 0.7,
                    'severity': 'medium',
                    'detection_type': 'packer_detected',
                    'metadata': {'packer': packer_name}
                })
        
        return threats
    
    def add_signature(self, signature: ThreatSignature):
        """Add a new threat signature."""
        self.signatures[signature.id] = signature
        
        # Update compiled patterns if regex
        if signature.signature_type == SignatureType.REGEX.value:
            try:
                self.compiled_patterns[signature.id] = re.compile(
                    signature.pattern,
                    re.IGNORECASE | re.DOTALL
                )
            except re.error as e:
                print(f"Failed to compile regex pattern: {e}")
    
    def remove_signature(self, signature_id: str):
        """Remove a threat signature."""
        if signature_id in self.signatures:
            del self.signatures[signature_id]
        if signature_id in self.compiled_patterns:
            del self.compiled_patterns[signature_id]
    
    async def behavioral_analysis(self, event_stream: List[Dict[str, Any]]) -> Dict[str, Any]:
        """
        Perform behavioral analysis on event stream.
        
        Args:
            event_stream: List of security events
            
        Returns:
            Behavioral analysis results
        """
        if not event_stream:
            return {'threat_level': 0, 'anomalies': []}
        
        # Calculate behavioral metrics
        events_per_second = len(event_stream) / 60  # Assuming 60-second window
        unique_sources = len(set(e.get('source', '') for e in event_stream))
        
        # Look for behavioral patterns
        anomalies = []
        
        # Burst detection
        if events_per_second > 100:  # More than 100 events per second
            anomalies.append({
                'type': 'event_burst',
                'confidence': min(1.0, events_per_second / 500),
                'severity': 'high',
                'description': f'High event rate: {events_per_second:.1f}/sec'
            })
        
        # Multiple source detection
        if unique_sources > 50:
            anomalies.append({
                'type': 'multiple_sources',
                'confidence': min(1.0, unique_sources / 200),
                'severity': 'medium',
                'description': f'Multiple sources: {unique_sources}'
            })
        
        # Sequence pattern detection
        event_types = [e.get('event_type', '') for e in event_stream]
        
        # Check for attack patterns
        attack_patterns = [
            ['port_scan', 'vulnerability_probe', 'exploit_attempt'],
            ['failed_login', 'failed_login', 'failed_login', 'successful_login'],
            ['file_access', 'file_modification', 'file_deletion']
        ]
        
        for pattern in attack_patterns:
            if self._contains_sequence(event_types, pattern):
                anomalies.append({
                    'type': 'attack_sequence',
                    'confidence': 0.85,
                    'severity': 'high',
                    'description': f'Detected attack sequence: {pattern}'
                })
        
        # Calculate overall threat level
        threat_level = 0.0
        for anomaly in anomalies:
            severity_weight = {
                'low': 0.3,
                'medium': 0.6,
                'high': 0.9,
                'critical': 1.0
            }
            threat_level += anomaly['confidence'] * severity_weight.get(anomaly['severity'], 0.5)
        
        threat_level = min(1.0, threat_level)
        
        return {
            'threat_level': threat_level,
            'anomalies': anomalies,
            'metrics': {
                'events_per_second': events_per_second,
                'unique_sources': unique_sources,
                'time_window_seconds': 60
            }
        }
    
    def _contains_sequence(self, sequence: List[str], pattern: List[str]) -> bool:
        """Check if sequence contains pattern (allowing for gaps)."""
        pattern_idx = 0
        for item in sequence:
            if item == pattern[pattern_idx]:
                pattern_idx += 1
                if pattern_idx == len(pattern):
                    return True
        return False
    
    def get_statistics(self) -> Dict[str, Any]:
        """Get performance statistics."""
        if self.performance_stats['scans_completed'] > 0:
            self.performance_stats['average_scan_time'] = (
                self.performance_stats['average_scan_time'] /
                self.performance_stats['scans_completed']
            )
        
        return {
            **self.performance_stats,
            'signatures_loaded': len(self.signatures),
            'compiled_patterns': len(self.compiled_patterns)
        }
    
    async def parallel_scan(self, scan_items: List[Any], scan_func) -> List[List[Dict[str, Any]]]:
        """
        Perform parallel scanning using thread pool.
        
        Args:
            scan_items: List of items to scan
            scan_func: Function to call for each item
            
        Returns:
            List of scan results
        """
        loop = asyncio.get_event_loop()
        tasks = []
        
        for item in scan_items:
            task = loop.run_in_executor(self.thread_pool, scan_func, item)
            tasks.append(task)
        
        results = await asyncio.gather(*tasks, return_exceptions=True)
        
        # Filter out exceptions
        valid_results = []
        for result in results:
            if not isinstance(result, Exception):
                valid_results.append(result)
        
        return valid_results
    
    def save_state(self, file_path: str):
        """Save current state to file."""
        state = {
            'signatures': self.signatures,
            'performance_stats': self.performance_stats
        }
        
        with open(file_path, 'wb') as f:
            pickle.dump(state, f)
    
    def load_state(self, file_path: str):
        """Load state from file."""
        try:
            with open(file_path, 'rb') as f:
                state = pickle.load(f)
            
            self.signatures = state['signatures']
            self.performance_stats = state['performance_stats']
            
            # Recompile patterns
            for sig_id, signature in self.signatures.items():
                if signature.signature_type == SignatureType.REGEX.value:
                    try:
                        self.compiled_patterns[sig_id] = re.compile(
                            signature.pattern,
                            re.IGNORECASE | re.DOTALL
                        )
                    except re.error:
                        pass
                        
        except FileNotFoundError:
            print(f"State file not found: {file_path}")

class InnateImmuneSystem:
    """
    Main innate immune system orchestrator.
    """
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.prrs = PatternRecognitionReceptor(config)
        self.active_scans = {}
        self.scan_history = []
        
    async def process_security_event(self, event: Dict[str, Any]) -> Dict[str, Any]:
        """
        Process a security event through innate immunity.
        
        Args:
            event: Security event dictionary
            
        Returns:
            Processing results with detected threats
        """
        start_time = datetime.now()
        
        # Extract event data
        event_type = event.get('event_type', 'unknown')
        event_data = event.get('data', {})
        
        detected_threats = []
        
        # Route to appropriate scanner
        if event_type == 'network_packet':
            packet_data = event_data.get('packet_data', b'')
            threats = await self.prrs.scan_network_packet(packet_data)
            detected_threats.extend(threats)
            
        elif event_type == 'file_scan':
            file_path = event_data.get('file_path', '')
            file_data = event_data.get('file_data')
            threats = await self.prrs.scan_file(file_path, file_data)
            detected_threats.extend(threats)
            
        elif event_type == 'behavioral_events':
            event_stream = event_data.get('events', [])
            behavioral_result = await self.prrs.behavioral_analysis(event_stream)
            
            if behavioral_result['threat_level'] > 0.7:
                detected_threats.append({
                    'detection_type': 'behavioral_anomaly',
                    'confidence': behavioral_result['threat_level'],
                    'severity': 'high',
                    'anomalies': behavioral_result['anomalies']
                })
        
        # Calculate processing time
        processing_time = (datetime.now() - start_time).total_seconds()
        
        result = {
            'event_id': event.get('event_id'),
            'event_type': event_type,
            'detected_threats': detected_threats,
            'processing_time_seconds': processing_time,
            'timestamp': datetime.now().isoformat()
        }
        
        # Store in history
        self.scan_history.append({
            'timestamp': datetime.now().isoformat(),
            'event_type': event_type,
            'threats_detected': len(detected_threats),
            'processing_time': processing_time
        })
        
        # Trim history if too large
        if len(self.scan_history) > 1000:
            self.scan_history = self.scan_history[-1000:]
        
        return result
    
    async def batch_process(self, events: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        """Process multiple events in batch."""
        results = []
        
        for event in events:
            result = await self.process_security_event(event)
            results.append(result)
        
        return results
    
    def get_system_status(self) -> Dict[str, Any]:
        """Get system status and statistics."""
        prr_stats = self.prrs.get_statistics()
        
        return {
            'system': 'innate_immunity',
            'status': 'active',
