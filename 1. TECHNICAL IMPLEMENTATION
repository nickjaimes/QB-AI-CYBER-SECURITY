from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
from cryptography.hazmat.primitives import padding
from cryptography.hazmat.backends import default_backend
import base64

class QKDProtocol(Enum):
    """Supported QKD protocols."""
    BB84 = "bb84"
    E91 = "e91"
    SARG04 = "sarg04"
    COW = "cow"

class QuantumState(Enum):
    """Quantum state representations."""
    ZERO = 0
    ONE = 1
    PLUS = 2  # |+> = (|0> + |1>)/√2
    MINUS = 3 # |-> = (|0> - |1>)/√2

@dataclass
class Qubit:
    """Represents a single qubit."""
    state: QuantumState
    basis: int  # 0 for computational (Z), 1 for Hadamard (X)
    id: str
    timestamp: datetime

@dataclass
class QuantumChannel:
    """Quantum communication channel."""
    channel_id: str
    protocol: QKDProtocol
    max_distance: float  # in kilometers
    loss_rate: float  # photons lost per km
    polarization_error: float
    timestamp: datetime

class QKDEngine:
    """
    Quantum Key Distribution Engine implementing BB84 protocol.
    """
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.protocol = QKDProtocol(config.get('protocol', 'bb84'))
        self.key_length = config.get('key_length', 256)
        self.error_threshold = config.get('error_threshold', 0.11)
        
        # Quantum state storage
        self.qubit_buffer: Dict[str, Qubit] = {}
        self.sifted_keys: Dict[str, List[int]] = {}
        self.final_keys: Dict[str, bytes] = {}
        
        # Error tracking
        self.error_rates: Dict[str, float] = {}
        self.key_rates: Dict[str, float] = {}
        
        # Security metrics
        self.security_metrics = {
            'keys_generated': 0,
            'keys_compromised': 0,
            'eavesdropping_detected': 0,
            'quantum_bit_error_rate': 0.0
        }
        
        # Classical communication channel (simulated)
        self.classical_channel = ClassicalChannel()
        
        print(f"Initialized QKD Engine with {self.protocol.value} protocol")
    
    def prepare_qubits(self, num_qubits: int, sender_id: str) -> List[Qubit]:
        """
        Prepare qubits for transmission (Alice's side).
        
        Args:
            num_qubits: Number of qubits to prepare
            sender_id: Sender identifier
            
        Returns:
            List of prepared qubits
        """
        qubits = []
        
        for i in range(num_qubits):
            # Randomly choose bit value (0 or 1)
            bit = secrets.randbelow(2)
            
            # Randomly choose basis (0 for Z, 1 for X)
            basis = secrets.randbelow(2)
            
            # Determine quantum state
            if basis == 0:  # Z basis
                state = QuantumState.ZERO if bit == 0 else QuantumState.ONE
            else:  # X basis
                state = QuantumState.PLUS if bit == 0 else QuantumState.MINUS
            
            qubit_id = f"{sender_id}_qubit_{i}_{datetime.now().timestamp()}"
            qubit = Qubit(
                state=state,
                basis=basis,
                id=qubit_id,
                timestamp=datetime.now()
            )
            
            qubits.append(qubit)
            
            # Store in buffer with encoded information
            encoded_info = (bit, basis)
            self.qubit_buffer[qubit_id] = qubit
        
        return qubits
    
    def measure_qubits(self, qubits: List[Qubit], receiver_id: str, 
                       bases: Optional[List[int]] = None) -> Tuple[List[int], List[int]]:
        """
        Measure qubits (Bob's side).
        
        Args:
            qubits: List of qubits to measure
            receiver_id: Receiver identifier
            bases: Optional list of measurement bases
            
        Returns:
            Tuple of (measured_bits, used_bases)
        """
        if bases is None:
            # Randomly choose measurement bases
            bases = [secrets.randbelow(2) for _ in range(len(qubits))]
        
        measured_bits = []
        
        for qubit, basis in zip(qubits, bases):
            if qubit.basis == basis:
                # Same basis - measurement gives definite result
                if qubit.state in [QuantumState.ZERO, QuantumState.PLUS]:
                    measured_bit = 0
                else:
                    measured_bit = 1
            else:
                # Different basis - random result (50/50)
                measured_bit = secrets.randbelow(2)
            
            measured_bits.append(measured_bit)
        
        return measured_bits, bases
    
    async def bb84_key_exchange(self, alice_id: str, bob_id: str, 
                               num_qubits: int = 1000) -> Optional[bytes]:
        """
        Perform BB84 key exchange protocol.
        
        Args:
            alice_id: Sender identifier
            bob_id: Receiver identifier
            num_qubits: Number of qubits to exchange
            
        Returns:
            Shared secret key or None if failed
        """
        session_id = f"{alice_id}_{bob_id}_{datetime.now().timestamp()}"
        
        try:
            # Step 1: Alice prepares qubits
            print(f"[{session_id}] Step 1: Alice preparing {num_qubits} qubits...")
            qubits = self.prepare_qubits(num_qubits, alice_id)
            
            # Step 2: Transmit qubits (simulated)
            print(f"[{session_id}] Step 2: Transmitting qubits...")
            transmitted_qubits = self.simulate_transmission(qubits)
            
            # Step 3: Bob measures qubits
            print(f"[{session_id}] Step 3: Bob measuring qubits...")
            measured_bits, bob_bases = self.measure_qubits(transmitted_qubits, bob_id)
            
            # Step 4: Basis reconciliation over classical channel
            print(f"[{session_id}] Step 4: Basis reconciliation...")
            alice_bases = [q.basis for q in qubits]
            
            # Compare bases and keep bits where bases match
            matching_indices = []
            sifted_key_alice = []
            sifted_key_bob = []
            
            for i, (alice_basis, bob_basis) in enumerate(zip(alice_bases, bob_bases)):
                if alice_basis == bob_basis:
                    matching_indices.append(i)
                    # Get original bit from Alice
                    original_bit = 0 if qubits[i].state in [QuantumState.ZERO, QuantumState.PLUS] else 1
                    sifted_key_alice.append(original_bit)
                    sifted_key_bob.append(measured_bits[i])
            
            print(f"[{session_id}] Bases match at {len(matching_indices)} positions")
            
            if len(matching_indices) < self.key_length:
                print(f"[{session_id}] Insufficient matching bases for key length {self.key_length}")
                return None
            
            # Step 5: Error estimation
            print(f"[{session_id}] Step 5: Error estimation...")
            # Use subset of bits for error estimation
            sample_size = min(100, len(sifted_key_alice) // 2)
            sample_indices = secrets.SystemRandom().sample(range(len(sifted_key_alice)), sample_size)
            
            error_count = 0
            for idx in sample_indices:
                if sifted_key_alice[idx] != sifted_key_bob[idx]:
                    error_count += 1
            
            error_rate = error_count / sample_size
            self.error_rates[session_id] = error_rate
            
            print(f"[{session_id}] Estimated error rate: {error_rate:.3f}")
            
            if error_rate > self.error_threshold:
                print(f"[{session_id}] Error rate too high, possible eavesdropping")
                self.security_metrics['eavesdropping_detected'] += 1
                return None
            
            # Step 6: Error correction
            print(f"[{session_id}] Step 6: Error correction...")
            corrected_key = self.cascade_error_correction(sifted_key_alice, sifted_key_bob, error_rate)
            
            # Step 7: Privacy amplification
            print(f"[{session_id}] Step 7: Privacy amplification...")
            final_key = self.privacy_amplification(corrected_key, error_rate)
            
            # Step 8: Store keys
            key_id = f"key_{session_id}"
            self.final_keys[key_id] = final_key
            self.sifted_keys[session_id] = sifted_key_alice
            
            # Update metrics
            self.security_metrics['keys_generated'] += 1
            self.key_rates[session_id] = len(final_key) * 8  # bits
            
            print(f"[{session_id}] Key exchange successful!")
            print(f"[{session_id}] Generated {len(final_key)} byte key")
            print(f"[{session_id}] Key fingerprint: {hashlib.sha256(final_key).hexdigest()[:16]}")
            
            return final_key
            
        except Exception as e:
            print(f"[{session_id}] Key exchange failed: {e}")
            return None
    
    def simulate_transmission(self, qubits: List[Qubit], 
                             distance_km: float = 50.0) -> List[Qubit]:
        """
        Simulate quantum transmission with losses and errors.
        
        Args:
            qubits: List of qubits to transmit
            distance_km: Transmission distance in kilometers
            
        Returns:
            Transmitted qubits (some may be lost)
        """
        transmitted = []
        loss_rate = self.config.get('loss_rate_per_km', 0.2)
        polarization_error = self.config.get('polarization_error', 0.01)
        
        total_loss = 1 - np.exp(-loss_rate * distance_km)
        
        for qubit in qubits:
            # Simulate photon loss
            if secrets.random() < total_loss:
                continue  # Photon lost
            
            # Simulate polarization error
            if secrets.random() < polarization_error:
                # Randomly flip state
                if qubit.state == QuantumState.ZERO:
                    qubit.state = QuantumState.ONE
                elif qubit.state == QuantumState.ONE:
                    qubit.state = QuantumState.ZERO
                elif qubit.state == QuantumState.PLUS:
                    qubit.state = QuantumState.MINUS
                elif qubit.state == QuantumState.MINUS:
                    qubit.state = QuantumState.PLUS
            
            transmitted.append(qubit)
        
        print(f"Transmitted {len(transmitted)}/{len(qubits)} qubits "
              f"({len(qubits)-len(transmitted)} lost)")
        
        return transmitted
    
    def cascade_error_correction(self, alice_bits: List[int], 
                                bob_bits: List[int], 
                                error_rate: float) -> List[int]:
        """
        Perform Cascade error correction protocol.
        
        Args:
            alice_bits: Alice's bit string
            bob_bits: Bob's bit string
            error_rate: Estimated error rate
            
        Returns:
            Corrected bit string
        """
        # Simple parity-based error correction
        block_size = max(1, int(1 / error_rate))
        
        corrected_bits = bob_bits.copy()
        
        for i in range(0, len(alice_bits), block_size):
            block_end = min(i + block_size, len(alice_bits))
            
            # Calculate parity for Alice's block
            alice_parity = sum(alice_bits[i:block_end]) % 2
            
            # Calculate parity for Bob's block
            bob_parity = sum(corrected_bits[i:block_end]) % 2
            
            # If parities don't match, find and correct error
            if alice_parity != bob_parity:
                # Simple error location (in reality would use binary search)
                for j in range(i, block_end):
                    if alice_bits[j] != corrected_bits[j]:
                        corrected_bits[j] = alice_bits[j]
                        break
        
        # Verify correction
        errors_remaining = sum(a != b for a, b in zip(alice_bits, corrected_bits))
        print(f"Error correction: {errors_remaining} errors remaining")
        
        return corrected_bits
    
    def privacy_amplification(self, key_bits: List[int], 
                            error_rate: float) -> bytes:
        """
        Perform privacy amplification using universal hashing.
        
        Args:
            key_bits: Input bit string
            error_rate: Estimated error rate
            
        Returns:
            Amplified secure key
        """
        # Convert bits to bytes
        key_bytes = self._bits_to_bytes(key_bits)
        
        # Calculate secure key length based on error rate
        # Using Csiszár-Körner bound
        secure_fraction = 1 - 2 * binary_entropy(error_rate)
        secure_bits = int(len(key_bits) * secure_fraction)
        secure_bytes = max(16, secure_bits // 8)  # Minimum 16 bytes
        
        print(f"Privacy amplification: {len(key_bytes)} bytes -> {secure_bytes} bytes")
        
        # Use hash-based extraction
        extracted_key = hashlib.shake_128(key_bytes).digest(secure_bytes)
        
        return extracted_key
    
    def _bits_to_bytes(self, bits: List[int]) -> bytes:
        """Convert list of bits to bytes."""
        byte_array = bytearray()
        
        for i in range(0, len(bits), 8):
            byte = 0
            for j in range(8):
                if i + j < len(bits):
                    byte |= (bits[i + j] << (7 - j))
            byte_array.append(byte)
        
        return bytes(byte_array)
    
    def encrypt_with_qkd(self, data: bytes, key_id: str) -> Tuple[bytes, bytes]:
        """
        Encrypt data using QKD-generated key.
        
        Args:
            data: Data to encrypt
            key_id: QKD key identifier
            
        Returns:
            Tuple of (iv, ciphertext)
        """
        if key_id not in self.final_keys:
            raise ValueError(f"Key {key_id} not found")
        
        key = self.final_keys[key_id]
        
        # Generate random IV
        iv = secrets.token_bytes(16)
        
        # Encrypt using AES-GCM
        cipher = Cipher(
            algorithms.AES(key),
            modes.GCM(iv),
            backend=default_backend()
        )
        
        encryptor = cipher.encryptor()
        ciphertext = encryptor.update(data) + encryptor.finalize()
        
        return iv, ciphertext
    
    def decrypt_with_qkd(self, iv: bytes, ciphertext: bytes, 
                        key_id: str) -> bytes:
        """
        Decrypt data using QKD-generated key.
        
        Args:
            iv: Initialization vector
            ciphertext: Encrypted data
            key_id: QKD key identifier
            
        Returns:
            Decrypted plaintext
        """
        if key_id not in self.final_keys:
            raise ValueError(f"Key {key_id} not found")
        
        key = self.final_keys[key_id]
        
        # Decrypt using AES-GCM
        cipher = Cipher(
            algorithms.AES(key),
            modes.GCM(iv),
            backend=default_backend()
        )
        
        decryptor = cipher.decryptor()
        plaintext = decryptor.update(ciphertext) + decryptor.finalize()
        
        return plaintext
    
    def detect_eavesdropping(self, session_id: str, 
                            estimated_error_rate: float) -> bool:
        """
        Detect potential eavesdropping based on error rate.
        
        Args:
            session_id: Session identifier
            estimated_error_rate: Measured error rate
            
        Returns:
            True if eavesdropping suspected
        """
        # Theoretical QBER without eavesdropping
        theoretical_qber = self.config.get('theoretical_qber', 0.01)
        
        # Calculate threshold (theoretical + margin)
        threshold = theoretical_qber * 1.5
        
        if estimated_error_rate > threshold:
            self.security_metrics['eavesdropping_detected'] += 1
            return True
        
        return False
    
    async def continuous_key_refresh(self, alice_id: str, bob_id: str,
                                   refresh_interval: int = 3600):
        """
        Continuously refresh QKD keys at regular intervals.
        
        Args:
            alice_id: Sender identifier
            bob_id: Receiver identifier
            refresh_interval: Refresh interval in seconds
